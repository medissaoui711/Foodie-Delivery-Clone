# ============================================
# DELIVEROO CLONE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in values
# ============================================

# App
APP_ENV=production
PORT=8080

# Database (PostgreSQL)
POSTGRES_PASSWORD=SecurePass2026!

# Redis
REDIS_PASSWORD=RedisPass2026!

# JWT Secrets — CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-me!
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars!

# Stripe (get from stripe.com/dashboard)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Firebase (for push notifications — optional)
# FIREBASE_CREDENTIALS={"type":"service_account",...}

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Never commit .env to git
# 2. Use strong random values for JWT secrets:
#    openssl rand -hex 64
# 3. Use Docker secrets in Swarm/K8s production
